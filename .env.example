# Arquivo de exemplo de variáveis de ambiente locais (copie para .env se desejar sobrescrever)
POSTGRES_DB=radar_vagas
POSTGRES_USER=radar_vagas
POSTGRES_PASSWORD=radar_vagas_local
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/radar_vagas
SPRING_DATASOURCE_USERNAME=radar_vagas
SPRING_DATASOURCE_PASSWORD=radar_vagas_local

# Token opcional do GitHub para ampliar o rate limit de 60/h para 5000/h (NUNCA comitar token real)
GITHUB_TOKEN=

# Credenciais opcionais para ativar os agregadores de busca ampla (Etapa 2)
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
