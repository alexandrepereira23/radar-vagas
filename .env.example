# Arquivo de exemplo de variáveis de ambiente locais (copie para .env na raiz do projeto).
# O backend importa automaticamente este arquivo via spring.config.import
# (optional:file:./.env[.properties] e optional:file:../.env[.properties]),
# funcionando tanto ao iniciar a partir da raiz quanto a partir de backend/.
# NUNCA comite o arquivo .env nem exponha os valores das chaves.

POSTGRES_DB=radar_vagas
POSTGRES_USER=radar_vagas
POSTGRES_PASSWORD=radar_vagas_local
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/radar_vagas
SPRING_DATASOURCE_USERNAME=radar_vagas
SPRING_DATASOURCE_PASSWORD=radar_vagas_local

# Defina como false durante testes manuais de credenciais para preservar cotas de fornecedores
RADAR_COLETA_AGENDAMENTO_ATIVO=true

# Token opcional do GitHub (fine-grained sem escrita, leitura pública) para ampliar o limite de 60/h para 5000/h
GITHUB_TOKEN=

# Credenciais opcionais para habilitar e validar os agregadores implementados (Jooble Brasil e Adzuna Brasil)
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch ainda NÃO possui conector implementado nesta versão — deixe vazia e não contrate plano
JSEARCH_API_KEY=
